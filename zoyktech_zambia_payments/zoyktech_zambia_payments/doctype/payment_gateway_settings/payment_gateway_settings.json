{
  "doctype": "DocType",
  "module": "Zoyktech Zambia Payments",
  "name": "Payment Gateway Settings",
  "is_single": 1,
  "issingle": 1,
  "fields": [
    {
      "fieldname": "gateway_name",
      "fieldtype": "Select",
      "label": "Payment Gateway",
      "options": "ZoykTech\nOther Gateway",
      "default": "ZoykTech",
      "reqd": 1
    },
    {
      "fieldname": "section_break_1",
      "fieldtype": "Section Break",
      "label": "API Configuration"
    },
    {
      "fieldname": "api_key",
      "fieldtype": "Password",
      "label": "API Key",
      "mandatory_depends_on": "eval:doc.gateway_name == 'ZoykTech'"
    },
    {
      "fieldname": "secret_key",
      "fieldtype": "Password",
      "label": "Secret Key",
      "mandatory_depends_on": "eval:doc.gateway_name == 'ZoykTech'"
    },
    {
      "fieldname": "base_url",
      "fieldtype": "Data",
      "label": "Base URL",
      "default": "https://api.zoyktech.com",
      "mandatory_depends_on": "eval:doc.gateway_name == 'ZoykTech'"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "is_test_mode",
      "fieldtype": "Check",
      "label": "Test Mode",
      "default": 1
    },
    {
      "fieldname": "test_base_url",
      "fieldtype": "Data",
      "label": "Test Base URL",
      "default": "https://sandbox.zoyktech.com",
      "depends_on": "eval:doc.is_test_mode == 1"
    },
    {
      "fieldname": "webhook_secret",
      "fieldtype": "Password",
      "label": "Webhook Secret"
    },
    {
      "fieldname": "section_break_2",
      "fieldtype": "Section Break",
      "label": "Payment Methods"
    },
    {
      "fieldname": "enabled_payment_methods",
      "fieldtype": "Table",
      "label": "Enabled Payment Methods",
      "options": "Payment Method",
      "description": "Configure available payment methods"
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "default_payment_method",
      "fieldtype": "Select",
      "label": "Default Payment Method",
      "description": "Default method when no specific method is selected",
      "depends_on": "enabled_payment_methods"
    },
    {
      "fieldname": "section_break_3",
      "fieldtype": "Section Break",
      "label": "Advanced Settings"
    },
    {
      "fieldname": "auto_create_payment_links",
      "fieldtype": "Check",
      "label": "Auto-create Payment Links",
      "description": "Automatically create payment links when invoices are submitted",
      "default": 0
    },
    {
      "fieldname": "payment_link_expiry_days",
      "fieldtype": "Int",
      "label": "Payment Link Expiry (Days)",
      "default": 7,
      "description": "Default number of days before payment links expire"
    },
    {
      "fieldname": "payment_link_expiry_hours",
      "fieldtype": "Int",
      "label": "Payment Link Expiry (Hours)",
      "default": 0,
      "description": "Additional hours for expiry"
    },
    {
      "fieldname": "allow_partial_payments",
      "fieldtype": "Check",
      "label": "Allow Partial Payments",
      "description": "Allow customers to make partial payments",
      "default": 0
    },
    {
      "fieldname": "enable_email_notifications",
      "fieldtype": "Check",
      "label": "Enable Email Notifications",
      "description": "Send email notifications for payment status",
      "default": 1
    },
    {
      "fieldname": "enable_sms_notifications",
      "fieldtype": "Check",
      "label": "Enable SMS Notifications",
      "description": "Send SMS notifications for payment status",
      "default": 0
    },
    {
      "fieldname": "success_redirect_url",
      "fieldtype": "Data",
      "label": "Success Redirect URL",
      "description": "URL to redirect after successful payment"
    },
    {
      "fieldname": "failure_redirect_url",
      "fieldtype": "Data",
      "label": "Failure Redirect URL",
      "description": "URL to redirect after failed payment"
    }
  ],
  "permissions": [
    {
      "role": "Administrator",
      "read": 1,
      "write": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 0
    }
  ]
}
